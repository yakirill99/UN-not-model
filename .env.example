# Copy to .env: cp .env.example .env
# Values below work for local development out of the box.

ARENA_ENV=local
ARENA_LOG_LEVEL=INFO

# Database (used from sprint 4)
POSTGRES_USER=arena
POSTGRES_PASSWORD=arena
POSTGRES_DB=arena
DATABASE_URL=postgresql+asyncpg://arena:arena@localhost:5432/arena

# Auth (used from sprint 4) — replace in any non-local environment
JWT_SECRET=change-me-local-only

# Default rules and scenario for new games
ARENA_DEFAULT_RULES=v1.0
ARENA_DEFAULT_SCENARIO=smolny

# LLM lab (stage 14) — leave empty until then
LLM_PROVIDER=
LLM_API_KEY=
LLM_MONTHLY_BUDGET_USD=0

# Backend (sprint 4)
ARENA_ENV=dev
ARENA_DATABASE_URL=postgresql+asyncpg://arena:arena@localhost:5432/arena
ARENA_JWT_SECRET=dev-secret-change-me
